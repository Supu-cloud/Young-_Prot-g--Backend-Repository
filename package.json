{
    "name": "ieee-young-protege-food-ordering-backend",
    "version": "1.0.0",
    "private": true,
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
        "build": "rimraf dist && tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "seed": "tsx src/seed/seed.ts",
        "db:check": "tsx test-db.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "verify": "npm run lint && npm run typecheck",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,mjs}\" \"scripts/**/*.mjs\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,mjs}\" \"scripts/**/*.mjs\"",
        "prepare": "husky"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.10.0",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^4.22.2",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.5.0",
        "mongoose": "^8.24.1",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^9.0.4",
        "stripe": "^22.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^1.4.7",
        "@types/node": "^22.20.1",
        "@types/nodemailer": "^8.0.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "nodemon": "^3.1.4",
        "prettier": "^3.9.6",
        "rimraf": "^5.0.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix --max-warnings=0",
            "prettier --write"
        ],
        "*.{json,md,mjs}": "prettier --write"
    }
}
